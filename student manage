#include <algorithm>    //Contains STL algorithms. 
using namespace std; 
// Student Class 
class Student   
{ 
public:     
int rollNo; 
string name; 
float marks; 
//Creates a class named Student. 
//Data Members 
Student(int r, string n, float m) //Constructor, the constructor automatically runs. 
{ 
rollNo = r; 
name = n; 
marks = m; 
} 
}; 
// Template Class using STL Vector 
template <class T>   
class StudentManager 
{ 
private: 
vector<T> students;  
public: 
// Insert Student 
void insertStudent(T s) 
{ 
students.push_back(s);    
end of the vector. 
//Template Class 
//Creates a vector named 
//push_back() adds the object to the 
cout << "\nStudent Record Inserted Successfully.\n"; 
} 
// Display Students 
void displayStudents() 
{ 
if(students.empty())   
{ 
//If vector contains no records 
cout << "\nNo Student Records Found.\n"; 
return; 
} 
        cout << "\n---------------------------------------------\n"; 
        cout << "Roll No\tName\t\tMarks\n"; 
        cout << "---------------------------------------------\n"; 
 
        for(int i=0;i<students.size();i++)    //runs through every 
student. 
        { 
            cout << students[i].rollNo << "\t" 
                 << students[i].name << "\t\t" 
                 << students[i].marks << endl; 
        } 
    } 
 
    // Search Student 
    void searchStudent(int roll) 
    { 
        for(int i=0;i<students.size();i++) 
        { 
            if(students[i].rollNo==roll) 
            { 
                cout << "\nStudent Found\n"; 
                cout << "Roll No : " << students[i].rollNo << endl; 
                cout << "Name    : " << students[i].name << endl; 
                cout << "Marks   : " << students[i].marks << endl; 
                return; 
            } 
        } 
 
        cout << "\nStudent Not Found.\n"; 
    } 
 
    // Delete Student 
   void deleteStudent(int roll) 
 { 
     typename vector<T>::iterator it; 
 
     for(it = students.begin(); it != students.end(); it++) 
     { 
         if(it->rollNo == roll) 
         { 
            students.erase(it); 
            cout << "\nStudent Record Deleted Successfully.\n"; 
            return; 
         } 
     } 
 
     cout << "\nStudent Not Found.\n"; 
 } 
 
    // Sort Students  
    void sortStudents() 
    { 
        sort(students.begin(), students.end(), 
             [](T a, T b) 
             { 
                 return a.rollNo < b.rollNo; 
             }); 
 
        cout << "\nStudent Records Sorted Successfully.\n"; 
    } 
}; 
 
int main() 
{ 
    StudentManager<Student> manager;  //Creates an object which manages Student 
records. 
 
    int choice; 
    int roll; 
    string name; 
    float marks; 
 
    do 
    { 
        cout << "\n========== Student Management System ==========\n"; 
        cout << "1. Insert Student\n"; 
        cout << "2. Delete Student\n"; 
        cout << "3. Search Student\n"; 
        cout << "4. Sort Students\n"; 
        cout << "5. Display Students\n"; 
        cout << "6. Exit\n"; 
 
        cout << "Enter Choice : "; 
        cin >> choice; 
 
        switch(choice) 
        { 
            case 1: 
                cout << "Enter Roll No : "; 
                cin >> roll; 
 
                cout << "Enter Name : "; 
                cin >> name; 
 
                cout << "Enter Marks : "; 
                cin >> marks; 
 
                manager.insertStudent(Student(roll,name,marks)); 
                break; 
 
            case 2: 
                cout << "Enter Roll No to Delete : "; 
                cin >> roll; 
                manager.deleteStudent(roll); 
                break; 
 
            case 3: 
                cout << "Enter Roll No to Search : "; 
                cin >> roll; 
                manager.searchStudent(roll); 
                break; 
 
            case 4: 
                manager.sortStudents(); 
                break; 
 
            case 5: 
                manager.displayStudents(); 
                break; 
 
            case 6: 
                cout << "\nProgram Terminated.\n"; 
                break; 
 
            default: 
                cout << "\nInvalid Choice.\n"; 
        } 
 
    }while(choice!=6); 
 
    return 0; 
} 
